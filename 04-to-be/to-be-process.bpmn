<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:collaboration id="Collaboration_2">
    <bpmn:participant id="Participant_ToBe" name="Retail lending — loan application (to-be)" processRef="Process_2" />
    <bpmn:textAnnotation id="N2">
      <bpmn:text>Stage 1: queue ordered by lapse risk, not arrival order (BR-02)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A2" sourceRef="N2" targetRef="Task_PrioritisedCall" />
    <bpmn:textAnnotation id="N5">
      <bpmn:text>Checklist and receipt confirmation reduce the rework loop (BR-07)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A5" sourceRef="N5" targetRef="Task_Assess2" />
    <bpmn:textAnnotation id="N1">
      <bpmn:text>Stage 1: offers scored daily by elapsed time and response status (BR-01, BR-03)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A1" sourceRef="N1" targetRef="Task_Score" />
    <bpmn:textAnnotation id="N3">
      <bpmn:text>Stage 2: adds capacity without consuming handler time; subject to contact limits (BR-05, BR-08)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A3" sourceRef="N3" targetRef="Task_Reminder" />
  </bpmn:collaboration>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:laneSet id="LaneSet_2">
      <bpmn:lane id="Lane2_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2_Handling" name="Application handling">
        <bpmn:flowNodeRef>Task_Assess2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrioritisedCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2_Offer" name="Offer management">
        <bpmn:flowNodeRef>Task_CreateOffer2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Response2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Pending2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_2" name="Application submitted">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Assess2" name="Complete application with documentation checklist">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateOffer2" name="Create and send offer">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Score" name="Score live offer by lapse risk">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Risk" name="Risk level?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reminder" name="Send automated reminder (stage 2)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrioritisedCall" name="Call from risk-prioritised queue">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Return2" name="Return documents">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Validate2" name="Validate application">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Response2" name="Offer accepted?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Pending2" name="Application pending">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelled2" name="Cancelled with reason code">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_2" targetRef="Task_Assess2" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Assess2" targetRef="Task_CreateOffer2" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_CreateOffer2" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Score" targetRef="Gateway_Risk" />
    <bpmn:sequenceFlow id="F5" name="Low / medium" sourceRef="Gateway_Risk" targetRef="Task_Reminder" />
    <bpmn:sequenceFlow id="F6" name="No response" sourceRef="Task_Reminder" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="F7" name="High" sourceRef="Gateway_Risk" targetRef="Task_PrioritisedCall" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_PrioritisedCall" targetRef="Task_Return2" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Return2" targetRef="Task_Validate2" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Validate2" targetRef="Gateway_Response2" />
    <bpmn:sequenceFlow id="F11" name="Accepted" sourceRef="Gateway_Response2" targetRef="End_Pending2" />
    <bpmn:sequenceFlow id="F12" name="Declined or lapsed" sourceRef="Gateway_Response2" targetRef="End_Cancelled2" />
    <bpmn:textAnnotation id="N4">
      <bpmn:text>Reason code captured — declined vs non-responsive (BR-06)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A4" sourceRef="N4" targetRef="End_Cancelled2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane id="BPMNPlane_2" bpmnElement="Collaboration_2">
      <bpmndi:BPMNShape id="Participant_ToBe_di" bpmnElement="Participant_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1300" height="700" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane2_Offer_di" bpmnElement="Lane2_Offer" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="1270" height="280" />
